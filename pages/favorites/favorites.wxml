<!-- pages/favorites/favorites.wxml —— 我的收藏 -->
<view class="page {{a11yClass}}">

  <view class="count-bar">
    <text class="t-sub">共收藏 {{list.length}} 件辅具</text>
  </view>

  <!-- ========== 收藏列表 ========== -->
  <view class="media-card" wx:for="{{list}}" wx:key="id">
    <!-- 点击封面进入详情 -->
    <view class="cover-box" data-id="{{item.id}}" bindtap="onAidTap">
      <image class="cover-img" src="{{item.cover}}" mode="aspectFill"></image>
      <text class="cover-emoji">{{item.emoji}}</text>
    </view>

    <view class="media-body">
      <text class="t-title t-ellipsis" data-id="{{item.id}}" bindtap="onAidTap">{{item.name}}</text>
      <text class="t-sub t-clamp2 fav-desc">{{item.desc}}</text>
      <view class="flex-between">
        <text class="tag">{{item.stockText}}</text>
        <text class="remove-text" data-id="{{item.id}}" bindtap="onRemoveTap">取消收藏</text>
      </view>
    </view>
  </view>

  <!-- ========== 空状态 ========== -->
  <view class="empty" wx:if="{{list.length === 0}}">
    <text class="empty-icon">⭐</text>
    <text class="empty-text">还没有收藏任何辅具</text>
    <button class="btn-ghost empty-btn" bindtap="onGoAids">去辅具库看看</button>
  </view>

</view>
